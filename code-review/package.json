{
  "name": "code-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only evidence pipeline for Terminal Bench 3.0 task review",
  "scripts": {
    "tb3": "node --experimental-strip-types --no-warnings src/cli.ts",
    "collect-trajectories": "node --experimental-strip-types --no-warnings src/cli.ts collect-trajectories",
    "copy-working-copy": "node --experimental-strip-types --no-warnings src/cli.ts copy-working-copy",
    "prepare-review": "node --experimental-strip-types --no-warnings src/cli.ts prepare-review",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  }
}